import requests
import json

RIAK_URL = "http://localhost:8098"


def inserir(bucket, chave, dados):
    url = f"{RIAK_URL}/buckets/{bucket}/keys/{chave}"

    resposta = requests.put(
        url,
        data=json.dumps(dados),
        headers={"Content-Type": "application/json"}
    )

    if resposta.status_code in [200, 201, 204]:
        print(f"✓ {chave} inserido/atualizado em '{bucket}'")
        return True
    else:
        print(
            f"✗ Erro ao inserir {chave}: "
            f"HTTP {resposta.status_code}"
        )
        return False


def buscar(bucket, chave):
    url = f"{RIAK_URL}/buckets/{bucket}/keys/{chave}"

    resposta = requests.get(url)

    if resposta.status_code == 200:
        return resposta.json()

    return None


def excluir(bucket, chave):
    url = f"{RIAK_URL}/buckets/{bucket}/keys/{chave}"

    resposta = requests.delete(url)

    if resposta.status_code in [200, 204]:
        print(f"✓ {chave} excluído de '{bucket}'")
        return True
    else:
        print(
            f"✗ Erro ao excluir {chave}: "
            f"HTTP {resposta.status_code}"
        )
        return False


def listar_chaves(bucket):
    url = f"{RIAK_URL}/buckets/{bucket}/keys?keys=true"

    resposta = requests.get(url)

    if resposta.status_code == 200:

        chaves = resposta.json().get("keys", [])
        chaves_existentes = []

        for chave in chaves:

            consulta = requests.get(
                f"{RIAK_URL}/buckets/{bucket}/keys/{chave}"
            )

            if consulta.status_code == 200:
                chaves_existentes.append(chave)

        print(f"{bucket}: {chaves_existentes}")

    else:
        print(
            f"✗ Erro ao listar '{bucket}': "
            f"HTTP {resposta.status_code}"
        )


